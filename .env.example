# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 절대 git에 올리지 마세요)

# ── 서버 ───────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
# 로그인 기록·가격 데이터가 저장되는 폴더. 서버를 옮기거나 재배포해도 이 폴더만 지키면 됩니다.
DATA_DIR=./data
# HTTPS 로 운영할 때는 반드시 1 (로그인 쿠키가 HTTP 로는 전송되지 않게 합니다)
COOKIE_SECURE=0
# nginx·Caddy·클라우드 로드밸런서 뒤에서 운영할 때 1 (실제 접속자 IP 로 요청 제한을 겁니다)
TRUST_PROXY=0
# 1 로 두면 /docs (API 문서)가 열립니다. 운영에서는 0 권장
ENABLE_DOCS=0

# ── 거래명세서 자동 인식(없으면 예시 명세서로 체험 모드) ──────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# 한 달에 자동 인식 가능한 횟수(비용 보호). 사용자 한 명 기준
OCR_LIMIT_TRIAL=10
OCR_LIMIT_PAID=100

# ── 가입·요금 ───────────────────────────────────────────
TRIAL_DAYS=14
PRICE_MONTHLY=19900
# 가격 아래에 붙는 안내 문구(예: "VAT 포함", "초기 도입 사장님 할인가")
PRICE_NOTE=
# 체험이 끝난 뒤 보여줄 결제 안내(계좌이체·카카오톡 채널 등)
PAYMENT_NOTE=이용 신청은 아래 연락처로 문의해 주세요.
CONTACT_EMAIL=
# 화면 하단에 표시되는 사업자 상호(통신판매업 신고 후 입력)
BUSINESS_NAME=
# 값을 넣으면 가입할 때 이 코드를 입력해야 합니다. 시범 운영(초대제)할 때 쓰세요.
SIGNUP_CODE=

# ── 소셜 로그인(카카오·네이버·구글) ───────────────────────
# 서버의 공개 주소(끝에 / 없이). OAuth 콜백 주소와 메일 속 링크를 만드는 데 씁니다.
# 로컬 테스트: http://127.0.0.1:8000  /  운영: https://내도메인
APP_BASE_URL=http://127.0.0.1:8000
# 아래 세 쌍은 각 서비스 개발자 콘솔에서 앱을 만들고, Redirect URI에
# {APP_BASE_URL}/api/auth/oauth/<kakao|naver|google>/callback 을 등록한 뒤 발급받은 값을 넣으세요.
# 키를 넣은 제공자만 로그인 화면에 버튼이 나타납니다(비워 두면 그 버튼은 안 보임).
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 비밀번호 찾기 메일 발송(없으면 서버 로그에만 링크를 남기는 예시 모드) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── 참고 레시피 DB(선택) ───────────────────────────────
# 식품안전나라(foodsafetykorea.go.kr) 오픈API 인증키(무료). scripts/fetch_public_recipes.py 가 씁니다.
FOODSAFETY_KEY=
# 사장님이 양을 직접 확인해 저장한 레시피(요리 이름·재료·양만, 누구의 것인지는 저장 안 함)를 참고 DB에 쌓습니다. 끄려면 0
REF_CONTRIBUTE=1

# ── 주변 상권·추가 공공데이터(선택) ─────────────────────
# 공공데이터포털(data.go.kr)에서 '소상공인시장진흥공단_상가(상권)정보' 활용신청 후 받은 일반 인증키(무료)
DATA_GO_KR_KEY=
# 서울 열린데이터광장(data.seoul.go.kr) 인증키와, 보고 싶은 데이터셋의 서비스 이름(쉼표로 여러 개)
# 요청 인자가 필요하면 서비스명:인자1/인자2 로 적습니다. 서비스 이름은 각 데이터셋 페이지에서 확인하세요.
SEOUL_API_KEY=
SEOUL_SERVICES=

# 주소 -> 위도·경도 변환(네이버 클라우드 플랫폼 > AI·NAVER API > Maps 의 Geocoding 활용 신청 후 받은 키)
NAVER_MAP_KEY_ID=
NAVER_MAP_KEY=

# ── 보안(인터넷에 올릴 때) ─────────────────────────────
# ALLOWED_HOSTS=wongae.example.com   # 이 주소로 들어온 요청만 받음
# 도매마켓(판매자 센터) 전용 도메인. 비워 두면 도매마켓은 /partner 주소로만 열립니다.
# 넣으면 그 도메인의 첫 화면(/)이 도매마켓이 됩니다. ALLOWED_HOSTS 를 쓰면 이 도메인도 거기에 함께 넣으세요.
# MARKET_HOSTS=domae.example.com
# API_RATE_PER_MIN=120               # 로그인한 계정의 분당 요청 한도
# API_RATE_PER_DAY=15000             # 하루 한도
# AUTO_BLOCK_AFTER=5                 # 한도를 이만큼 넘으면 자동 차단
# AUTO_BLOCK_MINUTES=15
# EXPORT_PER_HOUR=12                 # CSV 내려받기 한도
# API_BLOCK_UA=1                     # 0 이면 크롤러·도구 이름 차단을 끔

# ── 사업자 정보(화면 하단·약관에 표시, 통신판매업 등 법적 표시 의무가 있으면 채우세요) ──
BUSINESS_NAME=
BIZ_CEO=
BIZ_REG_NO=
BIZ_ADDRESS=

# ── 운영자 화면(OCR 인식 로그, #/admin/ocr) ─────────────
# 이 화면을 볼 수 있는 계정의 이메일(쉼표로 구분, 대소문자 무관). 비워 두면 아무도 못 봄.
ADMIN_EMAILS=

# ── 후원하기 ────────────────────────────────────────
# 메뉴의 "후원하기"는 기본 켜짐(1). 숨기고 싶을 때만 0으로 둡니다.
DONATION_ENABLED=1
# 후원 금액을 순위에 공개할지는 이제 운영자가 여기서 정하지 않고, 후원하는 사장님이 후원할 때마다
# 직접 고릅니다(화면의 "금액 공개" 체크박스). 그래서 DONATION_AMOUNT_PUBLIC 환경변수는 더 이상 쓰지 않습니다.
#
# 아래 세 값이 비어 있으면(기본) 결제는 전부 모의(mock)로 처리되어 실제 결제창이 뜨지 않고
# 바로 테스트 승인됩니다. 토스페이먼츠(tosspayments.com/services)에 가맹점으로 가입하면
# 개발자센터 > API 키 메뉴에서 "결제위젯 연동"용 키를 받을 수 있습니다. 카카오페이·토스페이는
# 별도로 코드를 바꾸지 않아도, 토스 가맹점 어드민의 "간편결제" 설정에서 켜 두면 결제위젯 안에
# 결제수단으로 같이 나타납니다(2026-11 기준 토스 공식 안내 — 실제 계약 전 담당자에게 다시 확인하세요).
TOSS_SECRET_KEY=
TOSS_CLIENT_KEY=
# 토스 개발자센터 > 웹훅 메뉴에서 만든 웹훅의 시크릿(서버-서버 알림 서명 확인용, 선택이지만 운영에서는 권장)
TOSS_WEBHOOK_SECRET=

# ── 도매 마켓(역경매 + 떨이 광고) ───────────────────────
# 같은 (품목·원산지·등급·권역)에 서로 다른 사장님이 몇 명 이상이어야 수요를 공개하는지(익명성 보호)
MK_MIN_BUYERS=3
# 떨이 광고 노출 단가(원/일)와, 결제 신청 화면에 보여줄 계좌이체 안내
MK_AD_PRICE_PER_DAY=5000
MK_AD_BANK_NOTE=
# 사업자등록증 OCR 제공자: mock(기본, 예시 응답) | claude(ANTHROPIC_API_KEY 재사용) | upstage | clova
WS_OCR_PROVIDER=mock
# 공공데이터포털 "국세청_사업자등록정보 진위확인 및 상태조회 서비스" 인증키. 비어 있으면 결정적 목 응답.
NTS_API_KEY=
# 값을 넣으면 도매업체 가입할 때 이 코드를 입력해야 합니다(시범 운영 초대제, 선택).
WS_SIGNUP_CODE=
